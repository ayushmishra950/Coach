PORT=4600
# Leave empty ONLY for local development: an embedded MongoDB runs (data in server/.mongo-data)
# and "local demo mode" switches on (demo data, demo logins, demo payments, dev JWT secret).
# Production refuses to start without a real MONGO_URI.
MONGO_URI=
# Required whenever MONGO_URI is set: a long random string (32+ characters)
JWT_SECRET=change-this-to-a-long-random-string
# Comma-separated list of allowed web origins (also used for the live-chat socket)
CLIENT_URL=http://localhost:5173
# Seed demo data (public demo passwords!) into an empty database. Default: only in local demo mode.
# Never on in production.
# SEED_ON_EMPTY=true
# Show one-click demo logins on the Login page. Default: only in local demo mode.
# DEMO_LOGINS=true
# Time zone used for "today", due dates, attendance dates and monthly reports
APP_TIMEZONE=Asia/Kolkata
# Demo payments complete without a gateway. Default: only in local demo mode; never in production.
# DEMO_PAYMENTS=false
# Set to true when running behind Nginx / a load balancer (for correct client IPs)
# TRUST_PROXY=true
# Days a paid plan keeps working after its billing period ends
# BILLING_GRACE_DAYS=3
# Demo institute owner login used by the demo data (seed)
# OWNER_NAME=Rahul
# OWNER_EMAIL=owner@example.com
# OWNER_PASSWORD=a-strong-password
# First deploy only: creates the Super Admin account if none exists yet (also used by the demo data)
# SUPERADMIN_EMAIL=you@example.com
# SUPERADMIN_PASSWORD=a-strong-password
