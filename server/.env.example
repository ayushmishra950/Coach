PORT=4600
# Leave empty ONLY for local development: an embedded MongoDB runs (data in server/.mongo-data)
# and "local demo mode" switches on (demo data, demo logins, demo payments, dev JWT secret).
# Production refuses to start without a real MONGO_URI.
MONGO_URI=mongodb+srv://piyushqawar_db_user:<db_password>@cluster0.vlk8hdj.mongodb.net
# Optional comma-separated DNS server override when Node's default DNS resolver refuses SRV lookups.
# MONGO_DNS_SERVERS=1.1.1.1
# Required whenever MONGO_URI is set: a long random string (32+ characters)
JWT_SECRET=xK8mP2vN7qL4wR9tY3bF6hJ1cD5sA0zQ
# Comma-separated list of allowed web origins (also used for the live-chat socket)
CLIENT_URL=http://localhost:5173
# Seed demo data (public demo passwords!) into an empty database. Default: only in local demo mode.
# Never on in production.
# SEED_ON_EMPTY=true
# Show one-click demo logins on the Login page. Default: only in local demo mode.
# DEMO_LOGINS=true
# Time zone used for "today", due dates, attendance dates and monthly reports
APP_TIMEZONE=Asia/Kolkata
# Demo payments complete without a gateway. Default: only in local demo mode; never in production.
# DEMO_PAYMENTS=false
# Set to true when running behind Nginx / a load balancer (for correct client IPs)
# TRUST_PROXY=true
# Days a paid plan keeps working after its billing period ends
# BILLING_GRACE_DAYS=3
# Demo institute owner login used by the demo data (seed)
# OWNER_NAME=Rahul
# OWNER_EMAIL=owner@example.com
# OWNER_PASSWORD=a-strong-password
# First deploy only: creates the Super Admin account if none exists yet (also used by the demo data)
SUPERADMIN_EMAIL=ayush950mishra@gmail.com
SUPERADMIN_PASSWORD=Aayush@124

# ── CoachFlow plan subscriptions (the platform's own Razorpay account) ──
# Parent fee payments do NOT use these: each institute connects its own Razorpay in Settings → Online payments.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# ── CoachFlow plan payments by UPI QR (pure-upi), verified by the Super Admin ──
# Owners pay a unique amount (e.g. ₹999.37) straight to this UPI ID and enter the UTR. Empty = off.
# A business / merchant UPI ID is recommended. Send yourself ₹1 first to check it.
UPI_ID=
UPI_NAME=CoachFlow

# ── WhatsApp reminders (Meta WhatsApp Business Cloud API) ──
# Business-initiated messages need an approved template with 2 body variables: {{1}} title, {{2}} message.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_TEMPLATE=
WHATSAPP_TEMPLATE_LANG=en

# ── SMS reminders: SMS_PROVIDER=fast2sms (India) or twilio ──
SMS_PROVIDER=
FAST2SMS_API_KEY=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=

# ── Email (https://resend.com) ──
RESEND_API_KEY=
EMAIL_FROM=
# Added to 10-digit phone numbers for WhatsApp / SMS
DEFAULT_COUNTRY_CODE=91
